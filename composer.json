{
  "name": "sugarcommerce/outbox",
  "version": "1.0.0",
  "description": "A durable send queue on SQLite: rows claimed atomically under a lease so overlapping workers never send twice, a crashed worker's rows come back on their own, and retries follow a status-aware backoff policy. Plus a run lock for cron.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/outbox",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["outbox", "queue", "retry", "sqlite", "cron", "webhooks", "email"],
  "require": {
    "php": ">=8.5",
    "sugarcommerce/sqlite": "^1.0",
    "sugarcommerce/webhooks": "^1.0"
  },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Outbox\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Outbox\\Tests\\": "tests/" } },
  "repositories": [ { "type": "path", "url": "../*", "options": { "symlink": true } } ],
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/outbox/issues", "source": "https://github.com/sugarcommerce/outbox" }
}
